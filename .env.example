# Static website requires no environment variables.
# Local API only; do not commit secrets.
API_HOST=127.0.0.1
API_PORT=3001

# Optional local PostgreSQL URL; set actual credentials outside version control.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DB

# Optional trusted identity configuration; all three required together.
# OIDC_ISSUER=https://issuer.example
# OIDC_AUDIENCE=gracehill-api
# OIDC_JWKS_URL=https://issuer.example/keys

# Optional private administrative runtime, requires all OIDC settings above.
# ADMIN_ORIGIN=https://admin.example
# OIDC_CLIENT_ID=admin
# OIDC_AUTHORISATION_ENDPOINT=https://issuer.example/authorize
# OIDC_TOKEN_ENDPOINT=https://issuer.example/token
